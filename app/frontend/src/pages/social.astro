---
import '../styles/global.css';
import TrendingGrid from '../components/social/TrendingGrid';
import CryptoTopbar from '../components/layout/CryptoTopbar.astro';
const publicApiBaseUrl = import.meta.env.PUBLIC_DATAPULSE_API_BASE_URL || '';
---

<!DOCTYPE html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title data-i18n="title" data-i18n-en="Social - DataPulse">Sosyal Medya - DataPulse</title>
	</head>
	<body class="dp-social-page min-h-screen">
		<CryptoTopbar activePage="social" />

		<main class="dp-social-shell">
			<TrendingGrid client:only="solid-js" />
		</main>

		<div id="sessionExpiredModal" class="hidden fixed inset-0 z-50 bg-[#111111]/68 p-4">
			<div class="flex min-h-full items-center justify-center">
				<div class="dp-social-expired-modal">
					<div class="dp-social-kicker mb-3" data-i18n="common.sessionExpiredKicker">Oturum Süresi Doldu</div>
					<h2 class="text-3xl font-semibold text-[#f4f4f5]" data-i18n="common.sessionExpiredTitle">Demo oturumu sonlandı</h2>
					<p class="mt-3 text-sm leading-7 text-[#a1a1aa]">
						Oturum veya istek limiti tükenince sosyal akış kapanır. Yeni bir demo başlatınca feed yeniden açılır.
					</p>
					<button id="restartDemoBtn" class="dp-social-primary-button mt-6 w-full" data-i18n="common.sessionExpiredRestart">Yeni Demo Başlat</button>
				</div>
			</div>
		</div>

		<script define:vars={{ publicApiBaseUrl }}>
			function apiUrl(path) {
				return publicApiBaseUrl ? new URL(path, publicApiBaseUrl).toString() : path;
			}

			async function parseJsonResponse(response) {
				const text = await response.text();

				if (!text.trim()) {
					return null;
				}

				try {
					return JSON.parse(text);
				} catch (error) {
					console.warn('Received invalid JSON response.', error);
					return null;
				}
			}

			function getLocale() {
				const storedLocale = localStorage.getItem('dp-locale');
				if (storedLocale === 'en' || storedLocale === 'tr') {
					return storedLocale;
				}

				return navigator.language?.toLowerCase().startsWith('en') ? 'en' : 'tr';
			}

			function t(tr, en) {
				return getLocale() === 'en' ? en : tr;
			}

			function formatSessionWindow(requestsLeft, minutesLeft) {
				return getLocale() === 'en'
					? `${requestsLeft} requests / ${minutesLeft} min`
					: `${requestsLeft} istek / ${minutesLeft} dk`;
			}

			let sessionCheckInterval;
			let sessionBootstrapPromise = null;

			function setBannerState(state: 'normal' | 'warning' | 'danger') {
				const banner = document.getElementById('sessionBanner');
				if (!banner) return;
				banner.classList.remove('text-gray-400', 'text-amber-400', 'text-red-400');
				banner.classList.add(
					state === 'danger' ? 'text-red-400' : state === 'warning' ? 'text-amber-400' : 'text-gray-400',
				);
			}

			function updateSessionBanner(data) {
				const banner = document.getElementById('sessionBanner');
				if (!banner) return;
				banner.classList.remove('is-hidden');
				banner.setAttribute('aria-hidden', 'false');

				const minutesLeft = Math.floor(data.timeRemaining / 60);
				const requestsLeft = data.requestsRemaining;

				if (requestsLeft <= 0) {
					setBannerState('danger');
					banner.textContent = t('Limit doldu', 'Limit reached');
					return;
				}

				if (requestsLeft <= 10) {
					setBannerState('warning');
					banner.textContent = formatSessionWindow(requestsLeft, minutesLeft);
					return;
				}

				setBannerState('normal');
				banner.textContent = formatSessionWindow(requestsLeft, minutesLeft);
			}

			function showSessionExpired() {
				if (sessionCheckInterval) {
					clearInterval(sessionCheckInterval);
				}

				document.getElementById('sessionExpiredModal')?.classList.remove('hidden');
			}

			async function ensureDemoSession() {
				if (sessionBootstrapPromise) return sessionBootstrapPromise;

				sessionBootstrapPromise = fetch(apiUrl('/api/session/start'), {
					method: 'POST',
					credentials: 'include',
				})
					.then(() => undefined)
					.finally(() => {
						sessionBootstrapPromise = null;
					});

				return sessionBootstrapPromise;
			}

			const mobileMenuBtn = document.getElementById('mobileMenuBtn');
			const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
			const mobileMenuClose = document.getElementById('mobileMenuClose');
			const mobileMenuBackdrop = document.getElementById('mobileMenuBackdrop');

			function openMobileMenu() {
				mobileMenuOverlay?.classList.remove('hidden');
				document.body.style.overflow = 'hidden';
			}

			function closeMobileMenu() {
				mobileMenuOverlay?.classList.add('hidden');
				document.body.style.overflow = '';
			}

			mobileMenuBtn?.addEventListener('click', openMobileMenu);
			mobileMenuClose?.addEventListener('click', closeMobileMenu);
			mobileMenuBackdrop?.addEventListener('click', closeMobileMenu);

			async function checkSessionStatus() {
				try {
					const response = await fetch(apiUrl('/api/session/status'), {
						credentials: 'include',
					});
					const data = response.ok ? await parseJsonResponse(response) : null;

					if (!data?.active) {
						await ensureDemoSession();
						const retryResponse = await fetch(apiUrl('/api/session/status'), {
							credentials: 'include',
						});
						const retryData = retryResponse.ok ? await parseJsonResponse(retryResponse) : null;

						if (!retryData?.active) {
							showSessionExpired();
							return;
						}

						updateSessionBanner(retryData);
						return;
					}

					updateSessionBanner(data);
				} catch (error) {
					console.error('Failed to check session status:', error);
				}
			}

			document.getElementById('restartDemoBtn')?.addEventListener('click', () => {
				window.location.href = '/';
			});

			checkSessionStatus();
			sessionCheckInterval = window.setInterval(checkSessionStatus, 30000);
		</script>
	</body>
</html>
