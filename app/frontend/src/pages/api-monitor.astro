---
import AppShell from '../layouts/AppShell.astro';
import ApiMonitorMain from '../components/monitor/ApiMonitorMain';
---

<AppShell
	title="API Sağlığı - DataPulse"
	titleI18nKey="page.apiMonitor"
	activePage="api-monitor"
	eyebrow="API Sağlığı"
	heroTitle="API Sağlığı"
