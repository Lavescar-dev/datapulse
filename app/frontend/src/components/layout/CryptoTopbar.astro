---
import { defaultLocale, i18nMessages } from '../../lib/i18n';
import { buildDemoAccessHref, demoTargets } from '../../lib/demoAccess';
import CryptoSwitch from './CryptoSwitch.astro';

interface ModuleNavItem {
	href: string;
	label: string;
	key: string;
	i18nKey: string;
}

interface LandingNavItem {
	href: string;
	key: string;
	labelTr: string;
	labelEn: string;
}

interface Props {
	activePage: string;
	switchVariant?: 'cyber' | 'gruvbox';
	navMode?: 'landing' | 'app';
}

const { activePage, switchVariant = 'cyber', navMode = 'app' } = Astro.props;
const isLandingNav = navMode === 'landing';

const moduleNavItems: ModuleNavItem[] = [
	{ href: '/dashboard', label: 'Kripto', key: 'dashboard', i18nKey: 'nav.dashboard' },
	{ href: '/news', label: 'Haberler', key: 'news', i18nKey: 'nav.news' },
	{ href: '/social', label: 'Sosyal Medya', key: 'social', i18nKey: 'nav.social' },
	{ href: '/scraper', label: 'Scraper', key: 'scraper', i18nKey: 'nav.scraper' },
	{ href: '/seo', label: 'SEO', key: 'seo', i18nKey: 'nav.seo' },
	{ href: '/price-tracker', label: 'Fiyat', key: 'price-tracker', i18nKey: 'nav.priceTracker' },
	{ href: '/api-monitor', label: 'API', key: 'api-monitor', i18nKey: 'nav.apiMonitor' },
	{ href: '/dashboard-builder', label: 'Dashboard', key: 'dashboard-builder', i18nKey: 'nav.dashboardBuilder' },
];

const landingNavItems: LandingNavItem[] = [
	{ href: '#overview', key: 'overview', labelTr: 'Genel Bakış', labelEn: 'Overview' },
	{ href: '#modules', key: 'modules', labelTr: 'Modüller', labelEn: 'Modules' },
	{ href: '#access', key: 'access', labelTr: 'Erişim', labelEn: 'Access' },
];

const landingCtaHref = buildDemoAccessHref('/dashboard');
---

<header class:list={['shell-topbar sticky top-0 z-50 border-b border-gray-800 bg-gray-900', isLandingNav && 'shell-topbar--landing']}>
	<div class="dashboard-shell shell-topbar-inner py-4">
		<div class="flex items-center justify-between gap-4">
			<div class="flex items-center gap-4">
				<button
					id="mobileMenuBtn"
					class="p-2 text-gray-400 transition-colors hover:text-gray-100 md:hidden"
					aria-label="Open menu"
				>
					<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
				<a
					href={isLandingNav ? '#overview' : '/'}
					class:list={[
						'shell-topbar-brand bg-gradient-to-r from-blue-400 to-purple-600 bg-clip-text text-xl font-bold text-transparent transition-opacity hover:opacity-80 md:text-2xl',
						isLandingNav && 'shell-topbar-brand--landing'
					]}
				>
					DataPulse
				</a>
				{isLandingNav ? (
					<>
						<div class="hidden items-center gap-2 xl:flex">
							<span class="shell-topbar-kicker">{demoTargets.length} modül</span>
							<span class="shell-topbar-kicker" data-i18n-en="Gated live access">Canlı demo erişimi</span>
						</div>
						<nav class="hidden flex-wrap items-center gap-2 md:flex">
							{landingNavItems.map((item) => (
								<a
									href={item.href}
									data-i18n-en={item.labelEn}
									class="shell-topbar-link shell-topbar-link--landing text-sm text-gray-300 transition-colors hover:text-white"
								>
									{item.labelTr}
								</a>
							))}
						</nav>
					</>
				) : (
					<nav class="hidden flex-wrap gap-4 md:flex">
						{moduleNavItems.map((item) => (
							<a
								href={item.href}
								data-i18n={item.i18nKey}
								class:list={[
									'shell-topbar-link text-sm transition-colors',
									activePage === item.key ? 'font-medium text-blue-400' : 'text-gray-400 hover:text-gray-100',
								]}
							>
								{item.label}
							</a>
						))}
					</nav>
				)}
			</div>
			<div class="flex items-center gap-2">
				{isLandingNav ? (
					<a
						href={landingCtaHref}
						class="shell-topbar-cta hidden sm:inline-flex"
						data-i18n-en="Open Demo Platform"
					>
						Demo Platformunu Aç
					</a>
				) : (
					<slot name="headerActions" />
				)}
				<CryptoSwitch variant={switchVariant} />
			</div>
		</div>
	</div>
</header>

<div id="mobileMenuOverlay" class="fixed inset-0 z-50 hidden md:hidden">
	<div class="absolute inset-0 bg-black/50" id="mobileMenuBackdrop"></div>
	<div class="absolute top-0 left-0 h-full w-64 border-r border-gray-800 bg-gray-900" id="mobileMenuPanel">
		<div class="flex items-center justify-between border-b border-gray-800 p-4">
			<span class="bg-gradient-to-r from-blue-400 to-purple-600 bg-clip-text text-lg font-bold text-transparent">
				DataPulse
			</span>
			<button
				id="mobileMenuClose"
				class="p-2 text-gray-400 transition-colors hover:text-gray-100"
				aria-label="Close menu"
			>
				<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<nav class="space-y-2 p-4">
			{isLandingNav
				? landingNavItems.map((item) => (
						<a
							href={item.href}
							data-close-mobile-menu
							data-i18n-en={item.labelEn}
							class="block border border-transparent px-4 py-3 text-gray-300 transition-colors hover:border-gray-800 hover:bg-gray-800"
						>
							{item.labelTr}
						</a>
					))
				: moduleNavItems.map((item) => (
						<a
							href={item.href}
							data-i18n={item.i18nKey}
							class:list={[
								'block border border-transparent px-4 py-3 transition-colors',
								activePage === item.key
									? 'border-blue-400/20 bg-blue-400/10 font-medium text-blue-400'
									: 'text-gray-300 hover:border-gray-800 hover:bg-gray-800',
							]}
						>
							{item.label}
						</a>
					))}
		</nav>
		{isLandingNav && (
			<div class="border-t border-gray-800 p-4">
				<a
					href={landingCtaHref}
					data-i18n-en="Open Demo Platform"
					class="shell-topbar-cta flex w-full items-center justify-center"
				>
					Demo Platformunu Aç
				</a>
			</div>
		)}
	</div>
</div>

<script define:vars={{ demoTargets }}>
	const STORAGE_KEY = 'datapulse:demo-access';
	const ACCESS_TTL_MS = 8 * 60 * 60 * 1000;

	function hasWindow() {
		return typeof window !== 'undefined';
	}

	function parseJsonText(text) {
		if (!text || !text.trim()) {
			return null;
		}

		try {
			return JSON.parse(text);
		} catch {
			return null;
		}
	}

	function apiUrl(path, publicApiBaseUrl = '') {
		return publicApiBaseUrl ? new URL(path, publicApiBaseUrl).toString() : path;
	}

	function normalizeTargetPath(targetPath) {
		if (!targetPath) {
			return '/dashboard';
		}

		try {
			const url = new URL(targetPath, 'https://datapulse.local');
			return url.pathname || '/dashboard';
		} catch {
			return targetPath.split('?')[0] || '/dashboard';
		}
	}

	function createDemoAccessSession(draft) {
		return {
			accessId: `dp-demo-${Math.random().toString(36).slice(2, 10)}`,
			name: draft.name.trim(),
			email: draft.email.trim(),
			role: draft.role.trim(),
			organization: draft.organization.trim(),
			startedAt: new Date().toISOString(),
		};
	}

	function readDemoAccessSession() {
		if (!hasWindow()) {
			return null;
		}

		try {
			const raw = window.sessionStorage.getItem(STORAGE_KEY);
			if (!raw) {
				return null;
			}

			const parsed = JSON.parse(raw);
			if (
				typeof parsed !== 'object' ||
				typeof parsed?.accessId !== 'string' ||
				typeof parsed?.name !== 'string' ||
				typeof parsed?.email !== 'string' ||
				typeof parsed?.role !== 'string' ||
				typeof parsed?.organization !== 'string' ||
				typeof parsed?.startedAt !== 'string'
			) {
				window.sessionStorage.removeItem(STORAGE_KEY);
				return null;
			}

			const startedAt = new Date(parsed.startedAt);
			if (Number.isNaN(startedAt.getTime()) || Date.now() - startedAt.getTime() > ACCESS_TTL_MS) {
				window.sessionStorage.removeItem(STORAGE_KEY);
				return null;
			}

			return parsed;
		} catch {
			window.sessionStorage.removeItem(STORAGE_KEY);
			return null;
		}
	}

	function writeDemoAccessSession(session) {
		if (!hasWindow()) {
			return;
		}

		window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(session));
	}

	function clearDemoAccessSession() {
		if (!hasWindow()) {
			return;
		}

		window.sessionStorage.removeItem(STORAGE_KEY);
	}

	function buildDemoAccessHref(targetPath) {
		const params = new URLSearchParams();
		params.set('next', targetPath || '/dashboard');
		return `/demo-access?${params.toString()}`;
	}

	function getRequestedTarget(search, fallback = '/dashboard') {
		const params = new URLSearchParams(search);
		const next = params.get('next');

		if (!next || !next.startsWith('/') || next === '/demo-access') {
			return fallback;
		}

		return next;
	}

	function getDemoTarget(targetPath) {
		const normalizedTarget = normalizeTargetPath(targetPath);
		return demoTargets.find((target) => target.href === normalizedTarget) ?? demoTargets[0];
	}

	function getCurrentTargetPath() {
		if (!hasWindow()) {
			return '/dashboard';
		}

		return normalizeTargetPath(`${window.location.pathname}${window.location.search}`);
	}

	function redirectToDemoAccess(targetPath, replace = true) {
		if (!hasWindow()) {
			return;
		}

		const href = buildDemoAccessHref(targetPath);
		if (replace) {
			window.location.replace(href);
			return;
		}

		window.location.href = href;
	}

	async function startBackendDemoSession(publicApiBaseUrl = '') {
		const response = await fetch(apiUrl('/api/session/start', publicApiBaseUrl), {
			method: 'POST',
			credentials: 'include',
		});
		const text = await response.text();
		const data = parseJsonText(text);

		if (!response.ok || !data?.success) {
			throw new Error(data?.error || 'Demo oturumu başlatılamadı.');
		}

		return data;
	}

	async function fetchBackendSessionStatus(publicApiBaseUrl = '') {
		const response = await fetch(apiUrl('/api/session/status', publicApiBaseUrl), {
			credentials: 'include',
		});
		const text = await response.text();
		const data = parseJsonText(text);
		return response.ok ? data : null;
	}

window.DataPulseDemoAccess = {
	buildDemoAccessHref,
	clearDemoAccessSession,
	createDemoAccessSession,
		demoTargets,
		fetchBackendSessionStatus,
		getCurrentTargetPath,
		getDemoTarget,
		getRequestedTarget,
		readDemoAccessSession,
		redirectToDemoAccess,
		startBackendDemoSession,
	writeDemoAccessSession,
};
</script>

<script>
	const mobileMenuBtn = document.getElementById('mobileMenuBtn');
	const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
	const mobileMenuClose = document.getElementById('mobileMenuClose');
	const mobileMenuBackdrop = document.getElementById('mobileMenuBackdrop');

	function openMobileMenu() {
		mobileMenuOverlay?.classList.remove('hidden');
		document.body.style.overflow = 'hidden';
	}

	function closeMobileMenu() {
		mobileMenuOverlay?.classList.add('hidden');
		document.body.style.overflow = '';
	}

	mobileMenuBtn?.addEventListener('click', openMobileMenu);
	mobileMenuClose?.addEventListener('click', closeMobileMenu);
	mobileMenuBackdrop?.addEventListener('click', closeMobileMenu);
	document.querySelectorAll('[data-close-mobile-menu]').forEach((element) => {
		element.addEventListener('click', closeMobileMenu);
	});
</script>

<script define:vars={{ defaultLocale, i18nMessages }}>
	function resolveLocale(rawLocale) {
		return rawLocale === 'en' ? 'en' : 'tr';
	}

	function readMessage(locale, key) {
		const parts = key.split('.');
		let current = i18nMessages[locale];
		for (const part of parts) {
			current = current?.[part];
		}
		return typeof current === 'string' ? current : key;
	}

	function interpolate(template, params = {}) {
		return template.replace(/\{(\w+)\}/g, (_, token) => String(params[token] ?? ''));
	}

	function applyLocale(locale) {
		document.documentElement.lang = locale;

		document.querySelectorAll('[data-i18n], [data-i18n-en], [data-i18n-tr]').forEach((element) => {
			const key = element.dataset.i18n;
			const fallbackText = element.dataset.i18nTr ?? element.textContent ?? '';

			if (!element.dataset.i18nTr && fallbackText) {
				element.dataset.i18nTr = fallbackText;
			}

			const localizedValue =
				element.getAttribute(`data-i18n-${locale}`) ??
				(locale === 'tr' ? (element.dataset.i18nTr ?? fallbackText) : null) ??
				(key ? readMessage(locale, key) : null) ??
				(locale === 'en' ? (element.dataset.i18nEn ?? fallbackText) : null) ??
				fallbackText;

			element.textContent = localizedValue;
		});

		document.querySelectorAll('[data-i18n-attr]').forEach((element) => {
			const pairs = element.dataset.i18nAttr?.split(',') ?? [];
			for (const pair of pairs) {
				const [attributeName, key] = pair.split(':');
				if (!attributeName || !key) continue;
				element.setAttribute(attributeName.trim(), readMessage(locale, key.trim()));
			}
		});

		localStorage.setItem('dp-locale', locale);
		window.dispatchEvent(new CustomEvent('datapulse:localechange', { detail: { locale } }));
	}

	function getLocale() {
		const storedLocale = localStorage.getItem('dp-locale');
		if (storedLocale) {
			return resolveLocale(storedLocale);
		}

		if (navigator.language?.toLowerCase().startsWith('tr')) {
			return 'tr';
		}

		return resolveLocale(defaultLocale);
	}

	window.DataPulseI18n = {
		getLocale,
		setLocale: applyLocale,
		t: (key, params) => interpolate(readMessage(getLocale(), key), params),
	};

	const initialLocale = getLocale();

	const applyInitialLocale = () => applyLocale(initialLocale);
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', applyInitialLocale, { once: true });
	} else {
		applyInitialLocale();
	}
</script>
