---
import '../styles/global.css';
import CryptoTopbar from '../components/layout/CryptoTopbar.astro';

const publicApiBaseUrl = import.meta.env.PUBLIC_DATAPULSE_API_BASE_URL || '';

const modules = [
	{
		accent: '#00C2FF',
		accentRgb: '0, 194, 255',
		descEn: 'Live price tracking for the top 100 crypto assets and BTC dominance.',
		descTr: 'Top 100 kripto para anlık fiyat takibi ve BTC dominansı.',
		href: '/dashboard',
		icon: 'bar-chart-2',
		titleEn: 'Crypto Tracking',
		titleTr: 'Kripto Takip',
	},
	{
		accent: '#7B61FF',
		accentRgb: '123, 97, 255',
		descEn: 'Collect financial news and run algorithmic sentiment analysis.',
		descTr: 'Finans haberlerini toplayın, algoritmik duygu analizi yapın.',
		href: '/news',
		icon: 'globe',
		titleEn: 'News Aggregation',
		titleTr: 'Haber Toplama',
	},
	{
		accent: '#FF00D6',
		accentRgb: '255, 0, 214',
		descEn: 'Discover trending Reddit and GitHub content in real time.',
		descTr: 'Reddit ve GitHub trending içeriklerini anlık keşfedin.',
		href: '/social',
		icon: 'activity',
		titleEn: 'Social Media',
		titleTr: 'Sosyal Medya',
	},
	{
		accent: '#00C2FF',
		accentRgb: '0, 194, 255',
		descEn: 'Collect products and content automatically with rule-based scraping.',
		descTr: 'Ürün ve içerikleri kurallara bağlı otomatik olarak toplayın.',
		href: '/scraper',
		icon: 'code',
		titleEn: 'Web Scraper',
		titleTr: 'Web Scraper',
	},
	{
		accent: '#7B61FF',
		accentRgb: '123, 97, 255',
		descEn: 'Track site performance and mobile friendliness scores.',
		descTr: 'Site performansı ve mobil uyumluluk skorlaması.',
		href: '/seo',
		icon: 'search',
		titleEn: 'SEO Analysis',
		titleTr: 'SEO Analiz',
	},
	{
		accent: '#FF00D6',
		accentRgb: '255, 0, 214',
		descEn: 'Amazon TR and local marketplace price history with alerts.',
		descTr: 'Amazon TR ve yerel pazar fiyat geçmişi alarm sistemi.',
		href: '/price-tracker',
		icon: 'shopping-cart',
		titleEn: 'Price Tracking',
		titleTr: 'Fiyat Takip',
	},
	{
		accent: '#00C2FF',
		accentRgb: '0, 194, 255',
		descEn: 'Monitor API uptime and critical system health checks.',
		descTr: 'API uptime ve kritik sistem sağlık kontrolü.',
		href: '/api-monitor',
		icon: 'server',
		titleEn: 'API Monitoring',
		titleTr: 'API İzleme',
	},
	{
		accent: '#7B61FF',
		accentRgb: '123, 97, 255',
		descEn: 'Build fully customizable widget grids for your own dashboards.',
		descTr: 'Tamamen özelleştirilebilir widget grid yapısı.',
		href: '/dashboard-builder',
		icon: 'layout-dashboard',
		titleEn: 'Dashboard Builder',
		titleTr: 'Dashboard Builder',
	},
] as const;

const moduleIcons: Record<string, string> = {
	'bar-chart-2':
		'<rect x="5" y="10" width="3" height="10" rx="1"></rect><rect x="10.5" y="6" width="3" height="14" rx="1"></rect><rect x="16" y="3" width="3" height="17" rx="1"></rect><path d="M4 20h16"></path>',
	globe:
		'<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a15 15 0 0 1 0 18"></path><path d="M12 3a15 15 0 0 0 0 18"></path>',
	activity: '<path d="M22 12h-4l-3 7-4-14-3 7H2"></path>',
	code: '<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>',
	search: '<circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path>',
	'shopping-cart':
		'<circle cx="9" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle><path d="M3 4h2l2 12h10l2-8H6"></path>',
	server:
		'<rect x="3" y="4" width="18" height="5" rx="1.5"></rect><rect x="3" y="15" width="18" height="5" rx="1.5"></rect><path d="M8 6h.01M8 17h.01"></path>',
	'layout-dashboard':
		'<rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect>',
};
---

<!DOCTYPE html>
<html lang="tr" class="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title data-i18n-en="DataPulse - Real-Time Data Analysis">DataPulse - Gerçek Zamanlı Veri Analizi</title>
		<meta
			name="description"
			data-i18n-attr="content:page.homeMeta"
			content="DataPulse, gerçek zamanlı kripto, haber, sosyal medya, scraper, SEO, fiyat ve API izleme modüllerini tek yerde toplar."
		/>
	</head>
	<body class="dp-home-page landing-page min-h-screen bg-black font-['Inter',sans-serif] text-neutral-100 selection:bg-[#7B61FF]/40">
		<CryptoTopbar activePage="home" switchVariant="cyber" />

		<main class="relative overflow-hidden">
			<section class="relative overflow-hidden px-6 pb-24 pt-20 md:pb-32 md:pt-28 lg:pb-40 lg:pt-32">
				<div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

				<div class="relative mx-auto max-w-7xl">
					<div class="grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
						<div class="z-10">
							<div class="reveal-target" data-direction="up" style="transition-delay: 100ms;">
								<p class="mb-5 text-[10px] font-semibold uppercase tracking-[0.34em] text-neutral-500" data-i18n-en="Real-time intelligence engine">Gerçek zamanlı istihbarat motoru</p>
								<h1 class="text-5xl font-black leading-[0.92] tracking-tighter text-white sm:text-6xl md:text-[84px]">
									<span class="block" data-i18n-en="Real-Time">Gerçek Zamanlı</span>
									<span class="block bg-gradient-to-r from-[#00C2FF] via-[#7B61FF] to-[#FF00D6] bg-clip-text text-transparent" data-i18n-en="Data Analysis.">Veri Analizi.</span>
								</h1>
							</div>

							<div class="reveal-target" data-direction="up" style="transition-delay: 200ms;">
								<p class="mt-8 max-w-xl text-lg font-medium leading-8 text-neutral-500 sm:text-xl" data-i18n-en="Process millions of data points in seconds. Industrial-grade tracking for crypto, ecommerce, social media, and API signals.">
									Saniyeler içinde milyonlarca veri noktasını işleyin. Kripto, e-ticaret, sosyal medya ve API sinyalleri için endüstriyel standartta takip.
								</p>
							</div>

							<div class="reveal-target mt-10 flex flex-col gap-4 sm:flex-row sm:items-center" data-direction="up" style="transition-delay: 300ms;">
								<button
									id="startDemoBtn"
									class="group inline-flex w-full items-center justify-center gap-3 bg-white px-8 py-4 text-base font-black uppercase tracking-[0.24em] text-black transition-all duration-300 hover:bg-neutral-200 active:scale-[0.98] sm:w-[420px]"
								>
									<span data-start-label data-i18n-en="Start Analysis">Analizi Başlat</span>
									<svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M5 12h14"></path>
										<path d="m12 5 7 7-7 7"></path>
									</svg>
								</button>
							</div>
						</div>

						<div class="reveal-target relative hidden lg:block" data-direction="left" style="transition-delay: 400ms;">
							<div class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#080808] shadow-[0_0_60px_rgba(0,0,0,0.45)]">
								<div class="flex items-center gap-3 border-b border-white/5 bg-white/5 px-5 py-4">
									<div class="flex gap-2">
										<div class="h-2.5 w-2.5 rounded-full bg-white/10"></div>
										<div class="h-2.5 w-2.5 rounded-full bg-white/10"></div>
										<div class="h-2.5 w-2.5 rounded-full bg-white/10"></div>
									</div>
									<div class="mx-auto font-['JetBrains_Mono',monospace] text-[10px] font-bold tracking-[0.35em] text-neutral-500" data-i18n-en="ENVIRONMENT_CONFIG">ORTAM_KONFİGÜRASYONU</div>
								</div>
								<div class="p-8 font-['JetBrains_Mono',monospace] text-[13px] leading-relaxed text-neutral-400">
									<p class="mb-4 italic text-neutral-600" data-i18n-en="// Manage your system access keys through the .env file">// Sistem erişim anahtarınızı .env dosyasından yönetin</p>
									<p><span class="text-[#FF00D6]">const</span> <span class="text-[#00C2FF]">CONFIG</span> = {'{'}</p>
									<p class="pl-6">apiKey: <span class="text-amber-400">"dp_live_8f92a1..."</span>,</p>
									<p class="pl-6">refreshRate: <span class="text-orange-300">500</span>, <span class="text-neutral-700">// ms</span></p>
									<p class="pl-6">engine: <span class="text-emerald-400">"Astro + SolidJS"</span>,</p>
									<p class="pl-6">logLevel: <span class="text-amber-400">"verbose"</span></p>
									<p>{'}'};</p>
									<div class="mt-6 flex items-center gap-2">
										<span class="font-bold text-[#00C2FF]">Engine:</span>
										<span class="font-bold text-emerald-400 animate-pulse" data-i18n-en="READY_TO_COLLECT">TOPLAMAYA HAZIR</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="modules" class="bg-[#020202] px-6 py-24 sm:py-28 lg:py-32">
				<div class="mx-auto max-w-7xl">
					<div class="reveal-target mb-16" data-direction="up">
						<h2 class="text-3xl font-black tracking-tighter text-white sm:text-4xl md:text-5xl" data-i18n-en="Modular Architecture">Modüler Mimari</h2>
						<p class="mt-5 max-w-2xl text-lg font-medium text-neutral-500" data-i18n-en="High-performance monitoring modules designed for each signal type.">
							Her veri tipi için özelleştirilmiş, yüksek performanslı izleme modülleri.
						</p>
					</div>

					<div class="grid grid-cols-1 gap-1 md:grid-cols-2 xl:grid-cols-4">
						{modules.map((mod, idx) => (
							<a
								href={mod.href}
								data-demo-link
								class="landing-card reveal-target group relative overflow-hidden border border-white/5 bg-[#050505] p-10 transition-all duration-300 hover:bg-[#080808]"
								data-direction="up"
								style={`--module-accent:${mod.accent}; --module-accent-rgb:${mod.accentRgb}; transition-delay:${idx * 50}ms;`}
							>
								<div class="mb-8 inline-flex rounded-xl bg-white/5 p-3 transition-transform duration-500 group-hover:scale-110" style={`color: ${mod.accent};`}>
									<svg
										class="h-6 w-6"
										fill="none"
										stroke="currentColor"
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="1.8"
										viewBox="0 0 24 24"
										aria-hidden="true"
										set:html={moduleIcons[mod.icon]}
									></svg>
								</div>
								<h3 class="mb-4 text-xl font-bold tracking-tight text-white" data-i18n-en={mod.titleEn}>{mod.titleTr}</h3>
								<p class="text-sm font-medium leading-relaxed text-neutral-500" data-i18n-en={mod.descEn}>{mod.descTr}</p>
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="relative overflow-hidden border-t border-white/5 px-6 py-28 sm:py-32 lg:py-40">
				<div class="relative z-10 mx-auto max-w-4xl text-center">
					<div class="reveal-target" data-direction="up">
						<h2 class="text-4xl font-black tracking-tighter text-white sm:text-5xl md:text-7xl">
							<span data-i18n-en="Take Control of the">Veriyi</span>
							<span class="bg-gradient-to-r from-[#00C2FF] via-[#7B61FF] to-[#FF00D6] bg-clip-text text-transparent" data-i18n-en="Data">Kontrol Altına</span>
							<span data-i18n-en="Now.">Alın.</span>
						</h2>
						<p class="mx-auto mt-8 max-w-2xl text-lg font-medium leading-8 text-neutral-500 sm:text-xl" data-i18n-en="Join the early access program and give your team full control over the signal pipeline.">
							Sistem yöneticileri için tam erişim yetkisi sağlayan Early Access Programına bugün katılın.
						</p>
						<button
							id="ctaDemoBtn"
							class="mt-12 inline-flex items-center justify-center rounded-md bg-white px-12 py-4 text-lg font-black text-black transition-all duration-300 hover:bg-neutral-200 active:scale-[0.98]"
							data-i18n-en="Try It Free Now"
						>
							Şimdi Ücretsiz Dene
						</button>
					</div>
				</div>
			</section>
		</main>

		<script define:vars={{ publicApiBaseUrl }}>
			function apiUrl(path) {
				return publicApiBaseUrl ? new URL(path, publicApiBaseUrl).toString() : path;
			}

			async function parseJsonResponse(response) {
				const text = await response.text();

				if (!text.trim()) {
					return null;
				}

				try {
					return JSON.parse(text);
				} catch (error) {
					console.warn('Received invalid JSON response.', error);
					return null;
				}
			}

			function resolveLocale() {
				const storedLocale = localStorage.getItem('dp-locale');
				if (storedLocale === 'en' || storedLocale === 'tr') {
					return storedLocale;
				}

				if (window.DataPulseI18n?.getLocale) {
					return window.DataPulseI18n.getLocale();
				}

				return navigator.language?.toLowerCase().startsWith('en') ? 'en' : 'tr';
			}

			function t(tr, en) {
				return resolveLocale() === 'en' ? en : tr;
			}

			let sessionBootstrapPromise = null;

			async function ensureDemoSession() {
				if (sessionBootstrapPromise) return sessionBootstrapPromise;

				sessionBootstrapPromise = fetch(apiUrl('/api/session/start'), {
					method: 'POST',
					credentials: 'include',
				})
					.then(async (response) => {
						const data = await parseJsonResponse(response);
						if (!response.ok || !data?.success) {
							throw new Error(data?.error || t('Demo oturumu başlatılamadı. Lütfen tekrar deneyin.', 'Demo session could not be started. Please try again.'));
						}
					})
					.finally(() => {
						sessionBootstrapPromise = null;
					});

				return sessionBootstrapPromise;
			}

			async function openModule(href) {
				if (!href) return;

				try {
					await ensureDemoSession();
					window.location.href = href;
				} catch (error) {
					console.error('Failed to open module:', error);
					alert(error instanceof Error ? error.message : t('Bağlantı hatası. Sunucunun çalıştığından emin olun.', 'Connection error. Make sure the server is running.'));
				}
			}

			const startDemoButton = document.getElementById('startDemoBtn');
			const ctaDemoButton = document.getElementById('ctaDemoBtn');
			const startDemoLabel = startDemoButton?.querySelector('[data-start-label]');

			function setStartButtonLabel(label) {
				if (startDemoLabel) {
					startDemoLabel.textContent = label;
					return;
				}

				if (startDemoButton) {
					startDemoButton.textContent = label;
				}
			}

			async function launchDashboard() {
				if (!startDemoButton) return;

				setStartButtonLabel(t('Başlatılıyor...', 'Starting...'));
				startDemoButton.disabled = true;
				if (ctaDemoButton) {
					ctaDemoButton.disabled = true;
				}

				try {
					await ensureDemoSession();
					window.location.href = '/dashboard';
				} catch (error) {
					console.error('Failed to start demo:', error);
					alert(error instanceof Error ? error.message : t('Bağlantı hatası. Sunucunun çalıştığından emin olun.', 'Connection error. Make sure the server is running.'));
					setStartButtonLabel(t('Analizi Başlat', 'Start Analysis'));
					startDemoButton.disabled = false;
					if (ctaDemoButton) {
						ctaDemoButton.disabled = false;
					}
				}
			}

			startDemoButton?.addEventListener('click', launchDashboard);
			ctaDemoButton?.addEventListener('click', launchDashboard);

			document.querySelectorAll('[data-demo-link]').forEach((link) => {
				link.addEventListener('click', async (event) => {
					event.preventDefault();
					await openModule(link.getAttribute('href'));
				});
			});
		</script>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('revealed');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -50px 0px' },
				);

				document.querySelectorAll('.reveal-target').forEach((element) => {
					observer.observe(element);
				});
			});
		</script>

		<style is:global>
			html {
				scroll-behavior: smooth;
			}

			.landing-page {
				background: #000000;
			}

			.reveal-target {
				opacity: 0;
				transition: all 1000ms cubic-bezier(0.16, 1, 0.3, 1);
			}

			.reveal-target[data-direction='up'] {
				transform: translateY(3rem) scale(0.95);
			}

			.reveal-target[data-direction='down'] {
				transform: translateY(-3rem) scale(0.95);
			}

			.reveal-target[data-direction='left'] {
				transform: translateX(3rem);
			}

			.reveal-target[data-direction='right'] {
				transform: translateX(-3rem);
			}

			.reveal-target.revealed {
				opacity: 1;
				transform: translate(0, 0) scale(1);
			}

			.landing-card {
				--module-accent: #7b61ff;
				--module-accent-rgb: 123, 97, 255;
			}

			.landing-card::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				height: 3px;
				width: 0;
				background: linear-gradient(90deg, var(--module-accent), rgba(255, 0, 214, 0.88));
				transition: width 700ms ease;
			}

			.landing-card:hover {
				border-color: rgba(var(--module-accent-rgb), 0.5);
				box-shadow: 0 0 30px rgba(var(--module-accent-rgb), 0.12);
			}

			.landing-card:hover::after {
				width: 100%;
			}

			.landing-card svg {
				stroke: var(--module-accent);
			}
		</style>
	</body>
</html>
